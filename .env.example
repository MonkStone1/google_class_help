# Google Class Help — hosted deployment configuration (migration stage 2, §9).
#
# Copy to `.env`, fill in the real values, and keep it out of Git (already
# covered by .gitignore). Only this example file is committed: it contains
# placeholders, never real secrets.
#
#   cp .env.example .env
#
# All values are read from the process environment; nothing here is embedded
# into the frontend bundle or into the Docker image.

# --------------------------------------------------------------- mode
# development | production (§30/§51). Production derives its default Host
# allow-list from APP_BASE_URL and never trusts localhost implicitly.
APP_ENV=production

# 1 = hosted web service (web OAuth + server-side sessions, ADR-0020).
# Unset/0 = desktop build (loopback OAuth, ADR-0019) — unchanged.
GC_DASHBOARD_HOSTED=1

# --------------------------------------------------------- public URL
# Public base URL of the service. Used to derive the OAuth redirect URI when
# GOOGLE_REDIRECT_URI is not set explicitly, and (in production, when
# GC_DASHBOARD_ALLOWED_HOSTS is unset) the accepted Host name.
APP_BASE_URL=https://classroomhelp.pp.ua

# ------------------------------------------------- Host / Origin / proxy
# Accepted Host names, comma-separated. Unset: production accepts only the
# host of APP_BASE_URL; development also accepts localhost/127.0.0.1 (§28).
GC_DASHBOARD_ALLOWED_HOSTS=classroomhelp.pp.ua

# Exact cross-origin frontends that are intentionally kept. Same-origin
# production traffic needs no entry; "*" is rejected because credentialed
# cookies are used (§27).
GC_DASHBOARD_CORS_ORIGINS=

# Immediate reverse-proxy IPs/CIDRs whose X-Forwarded-Proto/Host may be
# believed. Empty (or a placeholder like this) means no forwarded header is
# trusted (§29), which is safe while COOKIE_SECURE is set explicitly.
GC_DASHBOARD_TRUSTED_PROXIES=replace-with-caddy-ip-or-cidr

# Session cookie flags (§30, ADR-0020). SameSite=Lax keeps the cross-site
# OAuth callback working; SameSite=none forces Secure on.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Optional __Host- cookie prefix (§37): exactly the constraint set above
# (Secure + Path=/ + no Domain). Requires COOKIE_SECURE=true — browsers
# reject a __Host- cookie without Secure, which would break sign-in.
# Off by default so plain-http development keeps working.
GC_DASHBOARD_COOKIE_HOST_PREFIX=0

# ------------------------------------------------- Google web OAuth client
# A SEPARATE client of type "Web application" in the same Google Cloud
# project (never the desktop client). The redirect URI must exactly match the
# one registered in the Google Cloud Console and be HTTPS in production.
#
# GOOGLE_CLIENT_ID is public. GOOGLE_CLIENT_SECRET is a server-only secret:
# it must never reach the browser, frontend/dist, logs or Git.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-the-web-client-secret
# Optional: defaults to ${APP_BASE_URL}/api/auth/callback
GOOGLE_REDIRECT_URI=https://classroomhelp.pp.ua/api/auth/callback

# -------------------------------------------- Turnstile (optional, DDoS §17)
# Cloudflare Turnstile challenge on LOGIN INITIATION only. Both keys empty
# (default) → no challenge, the flow is unchanged. Create a widget at
# Cloudflare Dashboard → Turnstile and paste the keys; the backend then
# verifies every POST /api/auth/login/start at Cloudflare siteverify
# (fail-closed), and GET /api/auth/login stops bypassing the challenge.
# The SITE key is public (goes to the browser widget); the SECRET key is
# server-only — it must never reach the React bundle, logs or Git.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------- OAuth token encryption key
# Fernet key encrypting Google access/refresh tokens at rest (oauth_tokens).
# Keep it outside the database and outside Git. Generate one with:
#   python tools/generate_hosted_secrets.py
GC_DASHBOARD_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# ----------------------------------------------------------- PostgreSQL
# Production datastore from migration stage 3 on (SQLite is not the hosted
# primary database). Driver: psycopg 3 — keep the "+psycopg" suffix.
DATABASE_URL=postgresql+psycopg://google_class_help:replace-me@localhost:5432/google_class_help
#
# Least privilege (§71): create a DEDICATED application role — never run the
# app or the web container as the postgres superuser. The app role needs
# SELECT/INSERT/UPDATE/DELETE on the schema's tables; it does not need to
# create or alter them. For stricter separation keep two roles:
#
#   CREATE ROLE gch_owner LOGIN PASSWORD '…';          -- migrations only
#   CREATE ROLE google_class_help LOGIN PASSWORD '…';  -- the app (DML only)
#   CREATE DATABASE google_class_help OWNER gch_owner;
#   GRANT USAGE ON SCHEMA public TO google_class_help;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public
#     TO google_class_help;
#
# The web container gets DATABASE_URL with the app role; migration/admin
# credentials stay with the deploy pipeline that runs `alembic upgrade head`
# and never enter the web container's environment, Git or logs.

# ----------------------------------------------- data / runtime paths
# Hosted services on Linux use a mounted volume (default /data); desktop
# builds keep %LOCALAPPDATA%\GoogleClassHelp. Override only when the volume
# is mounted elsewhere (§31).
GC_DASHBOARD_DATA_DIR=/data

# ----------------------------------------------- background sync (stage 5)
# Per-user scheduler/worker (ADR-0023). The web process does NOT run the
# schedule: its owner is the dedicated worker container (see sync_worker.py).
#
# Per-user sync budget (§18/§40, recounted in stage 9 — ADR-0027): each
# user's sync uses SYNC_MAX_WORKERS threads and the scheduler runs up to
# SYNC_MAX_CONCURRENT_USERS users at once, so the thread/API budget is the
# PRODUCT of the two. Stage 9 set the first-production defaults to the
# conservative pair 4 x 2 = 8 threads (was 16 for the single-user desktop):
# ~1,000 users + 25 teachers on a 10-minute interval averages ~600 Google
# requests/min (~10 QPS), an order below the per-project quota — raise the
# pair only together with the quota_errors/server_errors counters in the
# sync log (§40, backend/capacity.py recomputes the estimate).
GC_DASHBOARD_SYNC_WORKERS=2
GC_DASHBOARD_SYNC_INTERVAL_MINUTES=30
# Scheduler knobs: how often the worker scans for due users; the window the
# FIRST sync of each account is spread over (§64, anti-thundering-herd);
# how long a "running" sync_status row may stay before it is considered a
# crashed worker and can be re-claimed.
# On the 1 vCPU / 1 GB target a 30-minute interval plus a 600-second startup
# stagger keeps a 1,000-user fan-out near ~200 requests/min instead of the
# ~600 of a 10-minute interval; the queue is serialized by the claim in the
# DB, so a longer interval trades freshness for not saturating the box.
GC_DASHBOARD_SYNC_MAX_CONCURRENT_USERS=1
GC_DASHBOARD_SYNC_SCAN_INTERVAL_SECONDS=60
GC_DASHBOARD_SYNC_STARTUP_STAGGER_SECONDS=600
GC_DASHBOARD_SYNC_CLAIM_STALE_SECONDS=3600
# ADR-0032: after how many seconds a running sync may count as STUCK — the
# dashboard then offers "Restart sync", and POST /api/sync?restart=true will
# abandon the claim and start a new one. Deliberately independent of
# SYNC_CLAIM_STALE_SECONDS above: that one is the silent backstop for a dead
# worker, this one is what the USER is offered a button for, and it is published
# to the browser as sync_stuck_after_seconds so the two can never disagree.
# Keep it above the slowest legitimate Classroom import (hundreds of courses on
# a 4-thread pool), otherwise the button appears for syncs that were fine and the
# server refuses the click with 409.
GC_DASHBOARD_SYNC_STUCK_SECONDS=300
# Opt-in ONLY for a single-replica deployment that cannot run a second
# process: run the per-user scheduler inside the web process. The supported
# architecture is the dedicated worker container; duplicate jobs stay
# impossible even in embedded mode (the DB claim serializes users).
GC_DASHBOARD_EMBEDDED_SCHEDULER=0
# Per-user cooldown between MANUAL syncs (stage 9, §39): pressing Sync
# again inside the window answers 429 + Retry-After instead of launching a
# second Classroom fan-out. Planned syncs bypass it. 0 disables.
GC_DASHBOARD_SYNC_MANUAL_COOLDOWN_SECONDS=60
# Retention sweep (stage 9, §44): expired/revoked sessions and expired OAuth
# login attempts are removed by the worker at most this often. 0 disables.
GC_DASHBOARD_RETENTION_SWEEP_SECONDS=3600

# -------------------------------------- rate limits / abuse control (stage 9)
# In-memory token buckets, hosted mode only, keyed by (surface, client IP)
# (§39). The client IP is the trusted proxy's X-Forwarded-For only when the
# peer is in GC_DASHBOARD_TRUSTED_PROXIES (proxy.py). Over-limit answers are
# 429 + Retry-After; nothing here authenticates or calls Google.
# Login starts (per IP, per minute).
GC_DASHBOARD_RATE_LIMIT_LOGIN_PER_MINUTE=10
# REJECTED OAuth callbacks only (per IP, per minute) — successful sign-ins
# are never throttled, so one school NAT can still sign in (§39).
GC_DASHBOARD_RATE_LIMIT_CALLBACK_FAILURES_PER_MINUTE=20
# Manual POST /api/sync (per IP, per minute), on top of the per-user
# cooldown above: the bucket stops a room of browsers, the cooldown stops
# one user holding the button (§39/§40).
GC_DASHBOARD_RATE_LIMIT_SYNC_PER_MINUTE=10
# Destructive cache clears DELETE /api/cache and /api/me/cache (per IP,
# per minute) — a rare operator action (§44/§66).
GC_DASHBOARD_RATE_LIMIT_CACHE_CLEAR_PER_MINUTE=10

# --------------------------------- PostgreSQL pool (stage 9, §45/§88)
# Deliberately small for the 1 vCPU / 1 GB target: a sync holds NO
# connection across the Google fetch (short transactions, §45), so web
# requests plus the bounded scheduler fit in pool_size + overflow
# connections. Raise together with vertical scaling only.
GC_DASHBOARD_DB_POOL_SIZE=3
GC_DASHBOARD_DB_MAX_OVERFLOW=2

# --------------------------------------------- HTTPS / security headers
# The reverse proxy (Caddy) terminates TLS and redirects HTTP→HTTPS; OAuth
# over plain HTTP is refused at startup in production (§36, config.py).
#
# HSTS (Strict-Transport-Security, §36/§48): max-age seconds, 0 = off.
# Stage 10 turned it ON for production (1 year + includeSubDomains, sent only
# on externally-https requests). If the Cloudflare edge is configured to send
# HSTS itself, set this back to 0 so the header is not sent twice.
GC_DASHBOARD_HSTS_MAX_AGE=31536000
#
# The app also always sends (hosted mode): X-Content-Type-Options: nosniff,
# Referrer-Policy: strict-origin-when-cross-origin, X-Frame-Options: DENY,
# Content-Security-Policy (same-origin only) and Cache-Control: no-store
# on /api (§48). Public info pages for Google OAuth verification:
# https://classroomhelp.pp.ua/privacy/ and /terms/ (§50).

# =====================================================================
# Container deployment (migration stage 10, §54–§57; DDoS plan §3/§26)
# =====================================================================
# These values are read by compose.yml (and by cloudflared). DATABASE_URL
# above is OVERRIDDEN inside the containers to point at the `postgres`
# service on the private Docker network, so its host part only matters for
# tooling you run from the VPS host itself.

# --- PostgreSQL container credentials ---
# Used by the `postgres` service and interpolated into the containers'
# DATABASE_URL. Pick a long random password; it is a server secret.
POSTGRES_DB=google_class_help
POSTGRES_USER=google_class_help
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Cloudflare Tunnel (DDoS plan §3) ---
# Remotely-managed tunnel token from Cloudflare Dashboard → Networking →
# Tunnels → Create Tunnel → publish the hostname classroomhelp.pp.ua to
# http://caddy:80 (the Caddy service on this Compose network).
# The token is a secret: it stays in .env, never in Git or the image.
# With the tunnel active the VPS needs NO inbound 80/443 ports open.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# --- Backups (DDoS plan §26) ---
# Directory on the VPS where tools/backup_postgres.sh writes dumps; keep a
# few rolling copies here and periodically move an encrypted copy offsite.
# DB dumps are git-ignored and are never uploaded anywhere automatically.
BACKUP_DIR=backups
BACKUP_KEEP=7

