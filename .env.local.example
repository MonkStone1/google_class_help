# Local hosted Docker configuration with real Google OAuth.
#
# Copy this file to .env.local and fill the four values below. The file
# is ignored by Git and is passed to containers as environment variables; it is
# never copied into the Docker image.
#
# Generate the token-encryption key with:
#   .venv\Scripts\python.exe tools\generate_hosted_secrets.py
#
# POSTGRES_PASSWORD must be URL-safe (letters, digits, '-' and '_' are enough),
# because compose.local.yml embeds it in DATABASE_URL.

# Local database
POSTGRES_DB=google_class_help_local
POSTGRES_USER=google_class_help_local
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password

# Separate Google OAuth client of type "Web application".
# Do not use backend/credentials.json: that is the desktop client.
GOOGLE_CLIENT_ID=replace-with-your-development-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-development-web-client-secret
GC_DASHBOARD_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# The local Compose file supplies the non-secret local settings:
# APP_ENV=development, GC_DASHBOARD_HOSTED=1, loopback OAuth callback,
# COOKIE_SECURE=false, and the dedicated worker. Keep this file limited to
# OAuth client settings, the token-encryption key, and local database
# credentials.
