# Secrets — never commit
backend/credentials.json
backend/embedded_secrets.py
data/token.json
data/*.db
# Hosted deployment secrets (migration stage 2): only .env.example is tracked.
.env
.env.local
backend/.env
!.env.example
# Database dumps and any other backup artifacts (migration stage 10, §57).
backups/
*.dump
*.sql.gz

# Local load-test artifacts (tools/loadtest_seed.py): synthetic session
# cookies and container-stat CSV dumps. Never commit them.
loadtest/

# Python
.venv/
__pycache__/
*.pyc
backend/.ruff_cache
.ruff_cache
.pytest_cache

# Node
frontend/node_modules/
frontend/dist/

# Production build artifacts (regenerated by build.bat)
build/
release/
assets/
logs/
data/
skills/
final.txt
finalerr.txt

# Test-run scratch files. They are the redirected stdout/stderr of a local
# `pytest` invocation, and they were previously spelled out in .gitignore one by
# one (final.txt, finalerr.txt). The pattern covers the general case: anything
# starting with a dot and ending in .txt/.err in the repo root is scratch.
.pt*.txt
.pt*.err
.pytest_baseline.txt
.pytest_baseline.err